VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GAME_CHAIN_ID=4663
# Display-only. The server-side contract setting remains authoritative.
VITE_CITIZEN_NFT_CONTRACT=

# Private Alpha remote smoke/deployment only. Never expose these in VITE_ vars.
ALPHA_SUPABASE_URL=https://your-alpha-project.supabase.co
ALPHA_SUPABASE_ANON_KEY=your-alpha-anon-key
ALPHA_SUPABASE_SERVICE_ROLE_KEY=your-alpha-service-role-key
ALPHA_SUPABASE_PROJECT_REF=your-alpha-project-ref

# Supabase Edge Function secrets. Never expose these as VITE_* variables.
ROBINHOOD_RPC_URL=
CITIZEN_NFT_CONTRACT=
CITIZEN_NFT_CHAIN_ID=4663
CITIZEN_NFT_STANDARD=erc721
CITIZEN_ELIGIBILITY_CACHE_TTL_SECONDS=60
# Temporary server-only migration flag. Remove after email Alpha accounts retire.
ALLOW_LEGACY_ALPHA_TESTERS=false
